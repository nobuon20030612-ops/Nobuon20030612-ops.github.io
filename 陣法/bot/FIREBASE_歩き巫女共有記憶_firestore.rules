rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validKnowledgeCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'schemaVersion', 'keyHash', 'normalizedKey', 'query', 'title',
          'answer', 'url', 'source', 'fetchedAt', 'expiresAt', 'volatile',
          'freshness', 'createdBy', 'createdAt'
        ])
        && d.schemaVersion == 1
        && d.keyHash is string && d.keyHash.size() >= 8 && d.keyHash.size() <= 64
        && d.normalizedKey is string && d.normalizedKey.size() > 0 && d.normalizedKey.size() <= 120
        && d.query is string && d.query.size() <= 120
        && d.title is string && d.title.size() <= 160
        && d.answer is string && d.answer.size() > 0 && d.answer.size() <= 1200
        && d.url is string && d.url.size() <= 500
        && d.url.matches('^https://ja\\.wikipedia\\.org/.*$')
        && d.source == 'Wikipedia'
        && d.fetchedAt is int
        && d.expiresAt is int
        && d.expiresAt >= d.fetchedAt
        && d.volatile is bool
        && d.freshness in ['general', 'live']
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    match /arukimiko_shared_knowledge_v1/{docId} {
      // Botは決め打ちのdocument IDだけをgetする。全件一覧取得は許可しない。
      allow get: if signedIn();
      allow list: if false;

      // 匿名認証済みユーザーが、検証済みのWikipedia調査結果だけ新規作成可能。
      // update/deleteを禁止し、共有記憶の上書き改変を抑える。
      allow create: if signedIn() && validKnowledgeCreate();
      allow update, delete: if false;
    }
  }
}
